{
  "expo": {
    "name": "Marquee",
    "slug": "marquee",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "marquee",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "ios": {
      "bundleIdentifier": "com.solyapps.marquee",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0b346ca8-3768-420f-b576-e7350763a4b6"
      }
    },
    "owner": "solomonsasson"
  }
}
