{
  "expo": {
    "name": "NSHA",
    "slug": "nsha",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nsha",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F3F6FA",
    "ios": {
      "bundleIdentifier": "com.solyapps.nsha",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "NSHA"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/nsha-logo.png",
          "imageWidth": 220,
          "dark": {
            "backgroundColor": "#0A0F16",
            "image": "./assets/nsha-logo.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5250115-571a-41ca-9bec-ed3f660eb795"
      }
    },
    "owner": "solomonsasson",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/c5250115-571a-41ca-9bec-ed3f660eb795",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
